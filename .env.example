# SeekAI API Configuration
NEW_API_KEY=your-seekai-api-key
SEEK_AI_MODEL=claude-opus-5
SEEK_AI_URL=https://seekai.cc/v1/messages

# Email Configuration (SMTP)
# Set these to enable email verification
# Leave empty to disable email functionality
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=auth-enclave@aurex.intelligence
SMTP_USE_TLS=true

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Database Configuration (future use)
DATABASE_URL=file:./data/aurex.db
