# Frontend Environment Variables (Set in Vercel Project Settings)
# VITE_API_BASE_URL=https://your-aurex-backend.onrender.com/api/v1
# VITE_WS_URL=wss://your-aurex-backend.onrender.com/ws/telemetry

# Backend Environment Variables (Set in Render Web Service Environment)
NEW_API_KEY=your_seekai_api_key_here
SEEK_AI_MODEL=claude-opus-4-8
SEEK_AI_URL=https://seekai.cc/v1/messages

# Gmail SMTP Configuration for Email Verification
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Local AI (LM Studio) Configuration (Optional)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=default

# Google OAuth (Optional - https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=

# GitHub OAuth (Optional - https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
